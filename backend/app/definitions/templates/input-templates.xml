<!-- Request XML templates referenced by workflow steps. Runtime values are inserted into template placeholders. -->
<InputTemplates>
  <Input id="getorderdetailsinput">
    <Order DocumentType="{{documentType}}"
           EnterpriseCode="{{enterpriseCode}}"
           OrderHeaderKey="{{orderHeaderKey}}"
           OrderNo="{{orderNo}}"/>
  </Input>
  <Input id="changeorderinput">
    <Order DisplayLocalizedFieldInLocale="xml:CurrentUser:/User/@Localecode"
           CallingOrganizationCode="{{callingOrganizationCode}}"
           Action="{{action}}"
           OrderHeaderKey="{{orderHeaderKey}}">
      <OrderHoldTypes>
        <OrderHoldType HoldLevel="{{holdLevel}}"
                       HoldType="{{holdType}}"
                       Status="{{status}}"
                       ReasonText="{{reasonText}}"/>
      </OrderHoldTypes>
    </Order>
  </Input>
  <Input id="getholdtypelistinput">
    <HoldType DisplayLocalizedFieldInLocale="xml:CurrentUser:/User/@Localecode"
              CallingOrganizationCode="{{callingOrganizationCode}}"
              DocumentType="{{documentType}}"
              HoldLevel="{{holdLevel}}"
              IgnoreOrdering="{{ignoreOrdering}}">
      <OrderBy>
        <Attribute Desc="{{orderByDescending}}" Name="{{orderByName}}"/>
      </OrderBy>
    </HoldType>
  </Input>

  <Input id="getorderlistinput">
    <Order
           OrderHeaderKey="{{orderHeaderKey}}"
           />
    
  </Input>


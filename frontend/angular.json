{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "workflow-studio": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/workflow-studio",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"optimization": true, "outputHashing": "all"},
            "render": {
              "optimization": {"scripts": true, "styles": true, "fonts": false},
              "fileReplacements": [{"replace": "src/app/operations-availability.ts", "with": "src/app/operations-availability.render.ts"}]
            },
            "development": {"optimization": false, "extractLicenses": false, "sourceMap": true}
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"proxyConfig": "proxy.conf.js"},
          "configurations": {
            "development": {"buildTarget": "workflow-studio:build:development"},
            "production": {"buildTarget": "workflow-studio:build:production"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": "c24d0a02-e27d-43dd-8503-944875c043c6"
  }
}
